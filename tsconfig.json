{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "chrome"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "extension/**/*.ts", "tests/**/*.ts"]
}
