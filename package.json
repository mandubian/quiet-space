{
  "name": "quiet-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "node build.mjs",
    "pretest": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.11.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
